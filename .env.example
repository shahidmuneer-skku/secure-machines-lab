# Copy to .env and fill in. Never commit .env.
# ---- Django ------------------------------------------------------------------
DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=sml.settings.dev
DJANGO_SECRET_KEY=            # >= 50 random chars (python -c "import secrets;print(secrets.token_urlsafe(64))")
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_WEB_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
API_KEY_PEPPER=               # random; rotating it invalidates every API key
API_KEY_ENV_LABEL=test        # "live" in production
FIELD_ENCRYPTION_KEY=         # random; encrypts Toss billing keys at rest

# ---- Infrastructure (deploy/compose/docker-compose.yml) -----------------------
POSTGRES_DB=sml
POSTGRES_USER=sml
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=postgres://sml:${POSTGRES_PASSWORD}@127.0.0.1:55432/sml
REDIS_PASSWORD=
REDIS_PORT=56379
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:56379/0
RABBITMQ_USER=sml
RABBITMQ_PASSWORD=
RABBITMQ_PORT=55672
RABBITMQ_MGMT_PORT=55673
CELERY_BROKER_URL=amqp://sml:${RABBITMQ_PASSWORD}@127.0.0.1:55672/sml
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:55673
RABBITMQ_MANAGEMENT_USER=sml
RABBITMQ_MANAGEMENT_PASSWORD=${RABBITMQ_PASSWORD}
RABBITMQ_VHOST=sml
S3_ENDPOINT_URL=http://127.0.0.1:58333
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:58333
S3_BUCKET=sml-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PORT=58333

# ---- First super admin (manage.py create_superadmin) ---------------------------
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---- Email (console backend until SMTP is configured) --------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL="Secure Machines Lab <no-reply@securemachineslab.com>"

# ---- Payments ------------------------------------------------------------------
BILLING_ENABLED=true
BILLING_PROVIDERS=toss,stripe
TOSS_CLIENT_KEY=              # test_ck_... (test mode) / live_ck_...
TOSS_SECRET_KEY=              # test_sk_... / live_sk_...
STRIPE_SECRET_KEY=            # sk_test_...
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=        # whsec_...

# ---- CAPTCHA (Cloudflare Turnstile; leave empty to disable) --------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Workers / models ----------------------------------------------------------
MODELS_ROOT=/home/shahidmuneer/fakedetector/fakedetector
LONG_VIDEO_ROOT=/home/shahidmuneer/fakedetector/long-video-processor
CONDA_ROOT=/home/shahidmuneer/anaconda3
SML_WORKER_SIMULATE=auto      # auto: simulate models whose conda env is missing; 1: always; 0: never
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENCLAUDE_BIN=/home/shahidmuneer/openclaude/bin/openclaude
OPENCLAUDE_SEARXNG_URL=http://127.0.0.1:8080
ANTHROPIC_API_KEY=            # only if the news engine is set to "claude"

# ---- Frontend (apps/web/.env.local) --------------------------------------------
# API_ORIGIN=http://127.0.0.1:8000
