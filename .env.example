# Secure Machines Lab configuration. Generate a working .env with:
#
#   python3 scripts/init_env.py            (random secrets, consistent URLs)
#
# Never commit .env. Format rules (the file is read by Django, Celery, Docker Compose and
# systemd): one KEY=value per line, comments on their own lines only, no ${VAR} expansion,
# quote values that contain spaces.

# ---- Django --------------------------------------------------------------------------
DJANGO_ENV=dev
DJANGO_SETTINGS_MODULE=sml.settings.dev
# At least 50 random characters: python3 -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_WEB_URL=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Random. Rotating it invalidates every API key.
API_KEY_PEPPER=
# "test" in development; production settings force "live".
API_KEY_ENV_LABEL=test
# Random string. Encrypts Toss billing keys at rest; changing it makes stored billing keys unreadable.
FIELD_ENCRYPTION_KEY=

# ---- Infrastructure (deploy/compose/docker-compose.yml) -------------------------------
# The *_URL values must repeat the passwords literally (no variable expansion).
POSTGRES_DB=sml
POSTGRES_USER=sml
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
DATABASE_URL=postgres://sml:POSTGRES_PASSWORD@127.0.0.1:55432/sml
REDIS_PASSWORD=
REDIS_PORT=56379
REDIS_URL=redis://:REDIS_PASSWORD@127.0.0.1:56379/0
RABBITMQ_USER=sml
RABBITMQ_PASSWORD=
RABBITMQ_PORT=55672
RABBITMQ_MGMT_PORT=55673
CELERY_BROKER_URL=amqp://sml:RABBITMQ_PASSWORD@127.0.0.1:55672/sml
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:55673
RABBITMQ_MANAGEMENT_USER=sml
RABBITMQ_MANAGEMENT_PASSWORD=
RABBITMQ_VHOST=sml
S3_ENDPOINT_URL=http://127.0.0.1:58333
# What browsers use for presigned media URLs (https://media.example.com in production).
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:58333
S3_BUCKET=sml-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PORT=58333

# ---- First super admin (manage.py create_superadmin) ----------------------------------
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ---- Email ----------------------------------------------------------------------------
# The compose "smtp" service (Postfix) listens on 127.0.0.1:25 and delivers to the recipients' mail
# servers. Receivers trust it more once this server's IP is in the domain's SPF record and has reverse
# DNS. To send through Google instead, set SMTP_RELAYHOST (Postfix keeps queueing and retrying):
#  - the Google Workspace SMTP relay (securemachineslab.com is on Workspace): [smtp-relay.gmail.com]:587,
#    no user or password; allow this server's outgoing IP in the Admin console → Apps → Google Workspace →
#    Gmail → Routing → SMTP relay service (only addresses in my domains, require TLS); or
#  - a mailbox: [smtp.gmail.com]:587 with SMTP_RELAYHOST_USERNAME = the address and
#    SMTP_RELAYHOST_PASSWORD = a 16-character App Password (Google refuses the account password).
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend only prints emails into the API log.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=127.0.0.1
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
SMTP_HOSTNAME=mail.securemachineslab.com
SMTP_SENDER_DOMAINS=securemachineslab.com
SMTP_RELAYHOST=
SMTP_RELAYHOST_USERNAME=
SMTP_RELAYHOST_PASSWORD=
DEFAULT_FROM_EMAIL="Secure Machines Lab <no-reply@securemachineslab.com>"
SUPPORT_EMAIL=support@securemachineslab.com

# ---- Payments -------------------------------------------------------------------------
BILLING_ENABLED=true
BILLING_PROVIDERS=toss,stripe
# test_ck_... in test mode, live_ck_... in production
TOSS_CLIENT_KEY=
# test_sk_... / live_sk_...
TOSS_SECRET_KEY=
# sk_test_... / sk_live_...
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# whsec_... (from the Stripe webhook endpoint for https://<app>/api/v1/billing/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=

# ---- CAPTCHA (Cloudflare Turnstile; leave empty to disable) ---------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Model workers --------------------------------------------------------------------
MODELS_ROOT=/home/shahidmuneer/fakedetector/fakedetector
LONG_VIDEO_ROOT=/home/shahidmuneer/fakedetector/long-video-processor
CONDA_ROOT=/home/shahidmuneer/anaconda3
# auto: simulate models whose conda env is missing (results are flagged simulated); 1: always; 0: never
SML_WORKER_SIMULATE=auto
# GPU for workers started without --gpu. GPU 1 (Blackwell) is reserved for Ollama.
SML_WORKER_DEFAULT_GPU=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
# The chat assistant (/assistant) talks to the same Ollama model as the agents. Keep its context size
# equal to theirs (sml_worker.agents.engine.NUM_CTX), or Ollama reloads the model between them.
# ASSISTANT_MODEL=qwen3.6:27b
# ASSISTANT_NUM_CTX=131072
# Seconds a reply may wait for the model, which serves one request at a time.
# ASSISTANT_READ_TIMEOUT=300
OPENCLAUDE_BIN=/home/shahidmuneer/openclaude/bin/openclaude
OPENCLAUDE_SEARXNG_URL=http://127.0.0.1:8080
# Only needed if the news engine is set to "claude" in the admin settings.
ANTHROPIC_API_KEY=

# ---- Long-form streaming (apps/stream, runs in the legacy conda env on its own GPU) ------
# Random. Signs scan tokens and authenticates the stream service's reports to the API.
STREAM_SHARED_SECRET=
STREAM_INTERNAL_URL=http://127.0.0.1:8100
# What browsers connect to. Production: /stream/ws (same origin, through nginx).
STREAM_PUBLIC_URL=ws://localhost:8100/stream/ws
STREAM_CONDA_ENV=safe
SML_STREAM_GPU=2
API_INTERNAL_URL=http://127.0.0.1:8000

