[Unit]
Description=SML image studio worker (generation and editing jobs; run on the studio server)
After=network-online.target docker.service
PartOf=sml.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@ROOT@/apps/worker
EnvironmentFile=@ROOT@/.env
# The images are made by the studio server (sml-resident.service, config/studio.yaml); this process
# checks prompts with Ollama, hands requests to the server and uploads the results. No GPU of its own.
Environment=CUDA_VISIBLE_DEVICES=
ExecStart=@ROOT@/apps/worker/.venv/bin/python -m sml_worker --studio --concurrency 2 --name sml-studio@%H
TimeoutStopSec=900
KillMode=mixed
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
UMask=0027

[Install]
WantedBy=sml.target
