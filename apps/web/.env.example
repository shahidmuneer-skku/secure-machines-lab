# apps/web environment (copy to .env.local for development). Server-only values: never prefix with NEXT_PUBLIC_.
# Django API the /api rewrites and server components talk to.
API_ORIGIN=http://127.0.0.1:8000
# Public origin of the S3-compatible storage (S3_PUBLIC_ENDPOINT_URL in the repo .env).
# Allowed by the Content-Security-Policy for thumbnails, media playback and direct multipart uploads.
STORAGE_ORIGIN=http://127.0.0.1:58333
# Long-form stream service for the CSP (development: the service's own port; production: empty,
# the browser uses the same origin through nginx).
STREAM_ORIGIN=ws://localhost:8100
